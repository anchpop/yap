---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — Yap.Town</title>
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet" />
  </head>
  <body class="font-sans antialiased">
    <div class="max-w-2xl mx-auto px-4 py-8">
      <div id="search-container" class="relative mb-6 hidden">
        <input
          id="search-input"
          type="text"
          placeholder="Search..."
          autocomplete="off"
          class="w-full rounded-lg border bg-card px-4 py-2 text-sm outline-none focus:border-accent-foreground"
        />
        <div id="search-results" class="absolute left-0 right-0 top-full z-50 mt-1 hidden max-h-80 overflow-y-auto rounded-lg border bg-card shadow-lg">
        </div>
      </div>
      <slot />
      <footer class="mt-12 pt-6 border-t text-center text-sm text-muted-foreground">
        <p>Part of <a href="/" class="text-accent-foreground hover:underline">Yap.Town</a> — Learn languages through real content</p>
      </footer>
    </div>
    <script>
      const path = window.location.pathname;
      const m = path.match(/^\/d\/([^/]+)\//);
      if (m && m[1] !== 'dictionary') {
        const courseSlug = m[1];
        const container = document.getElementById('search-container')!;
        const input = document.getElementById('search-input') as HTMLInputElement;
        const resultsDiv = document.getElementById('search-results')!;
        container.classList.remove('hidden');

        let data: { k: [string, number][]; r: [string, string, string][] } | null = null;
        let loading = false;
        let activeIdx = -1;

        async function ensureData() {
          if (data || loading) return;
          loading = true;
          try {
            const resp = await fetch(`/d/search/${courseSlug}.json`);
            data = await resp.json();
          } catch { loading = false; }
        }

        function binarySearchPrefix(keys: [string, number][], prefix: string): number {
          let lo = 0, hi = keys.length;
          while (lo < hi) {
            const mid = (lo + hi) >>> 1;
            if (keys[mid][0] < prefix) lo = mid + 1;
            else hi = mid;
          }
          return lo;
        }

        function search(query: string) {
          if (!data || !query) { resultsDiv.classList.add('hidden'); return; }
          const q = query.toLowerCase();
          const seen = new Set<number>();
          // Prefix matches: use binary search, collect page indices
          const prefixMatches: number[] = [];
          const idx = binarySearchPrefix(data.k, q);
          for (let i = idx; i < data.k.length; i++) {
            if (!data.k[i][0].startsWith(q)) break;
            const pi = data.k[i][1];
            if (!seen.has(pi)) { seen.add(pi); prefixMatches.push(pi); }
          }
          // Contains matches: linear scan, skip already-found prefix matches
          const containsMatches: number[] = [];
          for (let i = 0; i < data.k.length; i++) {
            const pi = data.k[i][1];
            if (seen.has(pi)) continue;
            if (data.k[i][0].includes(q)) {
              seen.add(pi);
              containsMatches.push(pi);
            }
          }
          // Sort each group by page index (= frequency rank, since pages are frequency-ordered)
          prefixMatches.sort((a, b) => a - b);
          containsMatches.sort((a, b) => a - b);
          const matches = prefixMatches.concat(containsMatches).slice(0, 20);
          if (!matches.length) { resultsDiv.classList.add('hidden'); return; }
          activeIdx = -1;
          resultsDiv.innerHTML = matches.map((pi, i) => {
            const [slug, display, preview] = data!.r[pi];
            return `<a href="/d/${courseSlug}/${slug}/" class="search-item block px-4 py-2 text-sm hover:bg-muted/50 cursor-pointer" data-idx="${i}"><span class="font-medium">${esc(display)}</span> <span class="text-muted-foreground">— ${esc(preview.slice(0, 80))}</span></a>`;
          }).join('');
          resultsDiv.classList.remove('hidden');
        }

        function esc(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

        function updateActive() {
          resultsDiv.querySelectorAll('.search-item').forEach((el, i) => {
            (el as HTMLElement).style.background = i === activeIdx ? 'var(--muted)' : '';
          });
        }

        let timer: number;
        input.addEventListener('input', () => { ensureData(); clearTimeout(timer); timer = setTimeout(() => search(input.value), 50) as unknown as number; });
        input.addEventListener('focus', () => { ensureData(); if (input.value) search(input.value); });
        input.addEventListener('blur', () => { setTimeout(() => resultsDiv.classList.add('hidden'), 150); });
        input.addEventListener('keydown', (e) => {
          const items = resultsDiv.querySelectorAll('.search-item');
          if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, items.length - 1); updateActive(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); updateActive(); }
          else if (e.key === 'Enter' && activeIdx >= 0 && items[activeIdx]) { e.preventDefault(); (items[activeIdx] as HTMLAnchorElement).click(); }
          else if (e.key === 'Escape') { resultsDiv.classList.add('hidden'); input.blur(); }
        });
      }
    </script>
  </body>
</html>
