---
import Layout from '../../layouts/Layout.astro';

const { course: courseSlug } = Astro.params;
const kv = Astro.locals.runtime.env.DICTIONARY_KV;

const courseDataJson = await kv.get(`index:${courseSlug}`);
if (!courseDataJson) return Astro.redirect('/d/');
const courseData = JSON.parse(courseDataJson);

const course = {
  slug: courseData.course_slug,
  target_language: courseData.target_language,
  native_language: courseData.native_language,
  total_pages: courseData.total_pages,
};

// Group pages by first letter
const letterGroups: Record<string, any[]> = {};
for (const page of courseData.pages) {
  const firstChar = page.display_text.charAt(0).toUpperCase();
  const letter = /[A-ZÀ-Ö]/.test(firstChar) ? firstChar.normalize('NFD').charAt(0).toUpperCase() : firstChar;
  if (!letterGroups[letter]) letterGroups[letter] = [];
  letterGroups[letter].push(page);
}

const sortedLetters = Object.keys(letterGroups).sort((a, b) => a.localeCompare(b));

function getDefinitionPreview(page: any): string {
  return page.first_sense_preview?.definition_preview ?? '';
}
---

<Layout
  title={`${course.target_language} → ${course.native_language} Dictionary`}
  description={`Browse ${course.total_pages.toLocaleString()} ${course.target_language} words and phrases with ${course.native_language} translations, examples, and pronunciation.`}
>
  <nav class="text-sm text-muted-foreground mb-4">
    <a href="/d/" class="hover:text-accent-foreground">Dictionaries</a>
    <span class="mx-1.5 opacity-50">›</span>
    {course.target_language} → {course.native_language}
  </nav>

  <div class="mb-6">
    <h1 class="text-3xl font-bold">{course.target_language} → {course.native_language} Dictionary</h1>
    <p class="text-muted-foreground mt-1">{course.total_pages.toLocaleString()} words and phrases, ordered by frequency</p>
  </div>

  <nav class="flex flex-wrap gap-1 mb-6">
    {sortedLetters.map((letter) => (
      <a href={`#${letter}`} class="inline-flex items-center justify-center w-8 h-8 rounded-sm bg-card border text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors no-underline">
        {letter}
      </a>
    ))}
  </nav>

  {sortedLetters.map((letter) => (
    <section id={letter} class="mb-8">
      <h2 class="text-lg font-bold mb-3">
        {letter}
        <span class="text-sm font-normal text-muted-foreground ml-2">({letterGroups[letter].length})</span>
      </h2>
      <div class="space-y-2">
        {letterGroups[letter].slice(0, 200).map((page: any) => (
          <a href={`/d/${course.slug}/${page.slug}/`} class="block rounded-lg border bg-card p-4 hover:bg-secondary transition-colors no-underline text-card-foreground">
            <div class="flex items-baseline justify-between gap-2 mb-1">
              <h3 class="text-xl font-semibold">
                {page.display_text}
                {page.first_sense_preview?.is_phrase && (
                  <span class="text-sm text-muted-foreground/60 font-normal ml-2">(phrase)</span>
                )}
              </h3>
              {page.first_sense_preview?.pronunciation && (
                <span class="text-sm text-muted-foreground shrink-0">{page.first_sense_preview.pronunciation}</span>
              )}
            </div>
            <div class="pl-4 border-l-2 border-muted">
              <div class="font-medium text-primary">{getDefinitionPreview(page)}</div>
            </div>
          </a>
        ))}
      </div>
      {letterGroups[letter].length > 200 && (
        <p class="text-sm text-muted-foreground py-3">
          ...and {letterGroups[letter].length - 200} more entries starting with "{letter}"
        </p>
      )}
    </section>
  ))}
</Layout>
