---
import Layout from '../../layouts/Layout.astro';

// Blog posts are listed newest-first. Add new posts to the top.
const posts = [
  // { slug: 'example-post', title: 'Example Post', date: '2026-03-11', summary: 'A summary.' },
];
---

<Layout title="Blog" description="Updates and thoughts on language learning, NLP, and building Yap.Town.">
  <div class="mb-6">
    <h1 class="text-3xl font-bold">Blog</h1>
  </div>

  {posts.length === 0 && (
    <p class="text-muted-foreground">No posts yet — check back soon.</p>
  )}

  <div class="space-y-6">
    {posts.map((post: any) => (
      <a href={`/blog/${post.slug}/`} class="block rounded-lg border bg-card p-4 hover:bg-secondary transition-colors no-underline">
        <div class="text-lg font-semibold text-card-foreground">{post.title}</div>
        <div class="text-sm text-muted-foreground mt-1">{post.date}</div>
        {post.summary && <p class="text-sm text-muted-foreground mt-2">{post.summary}</p>}
      </a>
    ))}
  </div>
</Layout>
