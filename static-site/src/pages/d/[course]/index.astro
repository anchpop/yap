---
import Layout from '../../../layouts/Layout.astro';

const { course: courseSlug } = Astro.params;
const kv = Astro.locals.runtime.env.DICTIONARY_KV;

const [lettersJson, coursesJson] = await Promise.all([
  kv.get(`letters:${courseSlug}`),
  kv.get('courses'),
]);

if (!lettersJson || !coursesJson) return Astro.redirect('/d/');

const letters = JSON.parse(lettersJson);
const courses = JSON.parse(coursesJson);
const courseMeta = courses.find((c: any) => c.slug === courseSlug);
if (!courseMeta) return Astro.redirect('/d/');

const totalPages = letters.reduce((sum: number, l: any) => sum + l.count, 0);
---

<Layout
  title={`${courseMeta.target_language} → ${courseMeta.native_language} Dictionary`}
  description={`Browse ${totalPages.toLocaleString()} ${courseMeta.target_language} words and phrases with ${courseMeta.native_language} translations, examples, and pronunciation.`}
  courseSlug={courseSlug}
>
  <nav class="text-sm text-muted-foreground mb-4">
    <a href="/d/" class="hover:text-accent-foreground">Dictionaries</a>
    <span class="mx-1.5 opacity-50">›</span>
    {courseMeta.target_language} → {courseMeta.native_language}
  </nav>

  <div class="mb-6">
    <h1 class="text-3xl font-bold">{courseMeta.target_language} → {courseMeta.native_language} Dictionary</h1>
    <p class="text-muted-foreground mt-1">{totalPages.toLocaleString()} words and phrases</p>
  </div>

  <div class="flex gap-3 mb-8">
    <a href={`/d/${courseSlug}/top-100/`} class="inline-flex items-center gap-1.5 rounded-lg border bg-card px-4 py-2 text-sm font-medium hover:bg-secondary transition-colors no-underline text-card-foreground">
      Top 100
    </a>
    <a href={`/d/${courseSlug}/top-1000/`} class="inline-flex items-center gap-1.5 rounded-lg border bg-card px-4 py-2 text-sm font-medium hover:bg-secondary transition-colors no-underline text-card-foreground">
      Top 1000
    </a>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
    {letters.map((l: any) => (
      <a href={`/d/${courseSlug}/letter/${l.letter}/`} class="rounded-lg border bg-card p-3 hover:bg-secondary transition-colors no-underline text-card-foreground group">
        <div class="flex items-baseline justify-between mb-1">
          <span class="text-lg font-bold">{l.letter}</span>
          <span class="text-xs text-muted-foreground">{l.count}</span>
        </div>
        {l.preview_words.length > 0 && (
          <p class="text-xs text-muted-foreground truncate">{l.preview_words.join(', ')}</p>
        )}
      </a>
    ))}
  </div>
</Layout>
