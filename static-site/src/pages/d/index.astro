---
import Layout from '../../layouts/Layout.astro';

const kv = Astro.locals.runtime.env.DICTIONARY_KV;
const coursesJson = await kv.get('courses');
if (!coursesJson) return Astro.redirect('/');
const courses = JSON.parse(coursesJson);

const languageFlags: Record<string, string> = {
  French: '\u{1F1EB}\u{1F1F7}',
  English: '\u{1F1EC}\u{1F1E7}',
  Spanish: '\u{1F1EA}\u{1F1F8}',
  Korean: '\u{1F1F0}\u{1F1F7}',
  German: '\u{1F1E9}\u{1F1EA}',
  Italian: '\u{1F1EE}\u{1F1F9}',
  Portuguese: '\u{1F1E7}\u{1F1F7}',
  Russian: '\u{1F1F7}\u{1F1FA}',
};
---

<Layout title="Dictionaries" description="Free online dictionaries for language learners. Browse words, phrases, and expressions with definitions, examples, and pronunciation.">
  <div class="mb-6">
    <h1 class="text-3xl font-bold">Dictionaries</h1>
    <p class="text-muted-foreground mt-1">Browse words, phrases, and expressions across multiple languages</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    {courses.map((course: any) => (
      <a href={`/d/${course.slug}/`} class="block rounded-lg border bg-card p-4 hover:bg-secondary transition-colors no-underline">
        <div class="text-lg font-semibold text-card-foreground">
          {languageFlags[course.target_language] || ''} {course.target_language} → {course.native_language}
        </div>
        <div class="text-sm text-muted-foreground mt-1">
          {course.total_pages.toLocaleString()} entries
        </div>
      </a>
    ))}
  </div>

  <div class="mt-10 text-sm text-muted-foreground space-y-2 max-w-xl">
    <h2 class="text-base font-semibold text-foreground">How it works</h2>
    <p>
      These dictionaries are built from real sentences — hundreds of thousands of them per language. Every word is extracted from natural text, so the definitions, examples, and frequency rankings reflect how words are actually used.
    </p>
    <p>
      Sentences are analyzed using <a href="/blog/unexpected-application-of-ml-theory-to-language-learning/" class="text-accent-foreground hover:underline">Lexide</a>, a set of custom machine learning models trained for language learning. They handle things like tokenization, lemmatization, and part-of-speech tagging across all supported languages.
    </p>
    <p>
      Patterns across sentences are also analyzed using a <a href="https://huggingface.co/learn/llm-course/en/chapter6/7" class="text-accent-foreground hover:underline">unigram language model</a> to automatically discover phrases, also known as multiword expressions. This matters because a lot of meaning lives in phrases — "ice cream" means something completely different from "ice" and "cream" on their own, so a good dictionary should give "ice cream" its own separate entry.
    </p>
  </div>
</Layout>
